@myyjaToken = bXl5amE6cGFzc3dvcmQ=
@jarjestajaToken = amFyamVzdGFqYTpwYXNzd29yZA==
@adminToken = YWRtaW46cGFzc3dvcmQ=

### Hae kaikki tapahtumat
GET http://localhost:8080/api/tapahtumat

### Hae kaikki poistetut tapahtumat
GET http://localhost:8080/api/tapahtumat?poistettu=true
Authorization: Basic {{adminToken}}

### Hae tapahtuma
GET http://localhost:8080/api/tapahtumat/1

### Hae tapahtuma jota ei ole
GET http://localhost:8080/api/tapahtumat/99999

### Lisää tapahtuma
POST http://localhost:8080/api/tapahtumat
Authorization: Basic {{jarjestajaToken}}
Content-Type: application/json

{
  "aika": "2026-10-05T20:00:00",
  "paikka": "Tavastia",
  "kaupunki": "Helsinki",
  "kuvaus": "Stand-up Comedy Night",
  "maxLippumaara": 700
}

### Lisää tapahtuma
POST http://localhost:8080/api/tapahtumat
Authorization: Basic {{jarjestajaToken}}
Content-Type: application/json

{
  "aika": "2026-07-15T19:00:00",
  "paikka": "Olympiastadion",
  "kaupunki": "Helsinki",
  "kuvaus": "Rock Festival 2026",
  "maxLippumaara": 40000
}

### Lisää tapahtuma
POST http://localhost:8080/api/tapahtumat
Content-Type: application/json
Authorization: Basic {{jarjestajaToken}}

{
  "id": 1,
  "aika": "2026-10-01T18:00:00",
  "paikka": "Finlandia-talo",
  "kaupunki": "Helsinki",
  "kuvaus": "Super-Gaala",
  "maxLippumaara": 1700
}

### Lisää virheellinen tapahtuma
POST http://localhost:8080/api/tapahtumat
Content-Type: application/json
Authorization: Basic {{jarjestajaToken}}

{
  "aika": "",
  "paikka": "",
  "kaupunki": "Helsinki",
  "kuvaus": "Stand-up Comedy Night",
  "maxLippumaara": -5
}

### Muokkaa tapahtumaa
PUT http://localhost:8080/api/tapahtumat/1
Content-Type: application/json
Authorization: Basic {{jarjestajaToken}}

{
  "aika": "2026-10-05T20:00:00",
  "paikka": "Tavastia",
  "kaupunki": "Helsinki",
  "kuvaus": "Stand-up Comedy Night",
  "maxLippumaara": 800
}

### Muokkaa tapahtumaa, jota ei ole
PUT http://localhost:8080/api/tapahtumat/99999
Content-Type: application/json
Authorization: Basic {{jarjestajaToken}}

{
  "aika": "2026-07-15T19:00:00",
  "paikka": "Olympiastadion",
  "kaupunki": "Helsinki",
  "kuvaus": "Rock Festival 2026 (Päivitetty)",
  "maxLippumaara": 45000
}

### Poista tapahtuma
DELETE http://localhost:8080/api/tapahtumat/3
Authorization: Basic {{jarjestajaToken}}

### Poista tapahtuma, jota ei ole
DELETE http://localhost:8080/api/tapahtumat/99999
Authorization: Basic {{jarjestajaToken}}

### Poista tapahtuma ilman oikeuksia
DELETE http://localhost:8080/api/tapahtumat/1
Authorization: Basic {{myyjaToken}}